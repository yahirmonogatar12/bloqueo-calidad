client-state.json
operator-cache.json
event-queue.jsonl

# IDE / tooling
.history/
.vs/
.vscode/
.idea/
*.suo
*.userprefs
*.cache
.codegraph/
publish/
# OS noise
Thumbs.db
desktop.ini
.DS_Store
deploy/station/appsettings.station.template.json
